<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#15161E"
    android:padding="4dp">

    <!-- Control Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SinTrans Keyboard"
            android:textColor="#888A9E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <Button
            android:id="@+id/btn_translate_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/key_background_accent_off"
            android:text="Translate: OFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>

    <!-- Key Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="අ"/>
        <Button style="@style/KeyStyle" android:text="ආ"/>
        <Button style="@style/KeyStyle" android:text="ඇ"/>
        <Button style="@style/KeyStyle" android:text="ඉ"/>
        <Button style="@style/KeyStyle" android:text="ඊ"/>
        <Button style="@style/KeyStyle" android:text="උ"/>
        <Button style="@style/KeyStyle" android:text="්"/>
        <Button style="@style/KeyStyle" android:text="ා"/>
        <Button style="@style/KeyStyle" android:text="ි"/>
        <Button style="@style/KeyStyle" android:text="ෙ"/>
    </LinearLayout>

    <!-- Key Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="ක"/>
        <Button style="@style/KeyStyle" android:text="ග"/>
        <Button style="@style/KeyStyle" android:text="ච"/>
        <Button style="@style/KeyStyle" android:text="ජ"/>
        <Button style="@style/KeyStyle" android:text="ට"/>
        <Button style="@style/KeyStyle" android:text="ඩ"/>
        <Button style="@style/KeyStyle" android:text="ත"/>
        <Button style="@style/KeyStyle" android:text="ද"/>
        <Button style="@style/KeyStyle" android:text="න"/>
        <Button style="@style/KeyStyle" android:text="ප"/>
    </LinearLayout>

    <!-- Key Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">
        <Button style="@style/KeyStyle" android:text="බ"/>
        <Button style="@style/KeyStyle" android:text="ම"/>
        <Button style="@style/KeyStyle" android:text="ය"/>
        <Button style="@style/KeyStyle" android:text="ර"/>
        <Button style="@style/KeyStyle" android:text="ල"/>
        <Button style="@style/KeyStyle" android:text="ව"/>
        <Button style="@style/KeyStyle" android:text="ස"/>
        <Button style="@style/KeyStyle" android:text="හ"/>
        <Button style="@style/KeyStyle" android:text="ළ"/>
        <Button style="@style/KeyStyle" android:text="ෆ"/>
    </LinearLayout>

    <!-- Key Row 4 (System Row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_globe"
            style="@style/KeyStyleSpecial"
            android:layout_weight="1.5"
            android:text="🌐"/>

        <Button
            android:id="@+id/btn_space"
            style="@style/KeyStyleSpecial"
            android:layout_weight="5.5"
            android:text="Space"/>

        <Button
            android:id="@+id/btn_backspace"
            style="@style/KeyStyleSpecial"
            android:layout_weight="2.0"
            android:text="⌫"/>
    </LinearLayout>

</LinearLayout>
